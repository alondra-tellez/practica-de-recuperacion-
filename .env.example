# Copia este archivo como .env y llena tus datos (el .env NO se sube a Git)
Mongo_User = tu_usuario
Mongo_Password = tu_contraseña
Mongo_Cluster = tucluster.xxxxx.mongodb.net
Mongo_BD = tu_base_de_datos

# Opcional: MongoDB local (Compass) en lugar de Atlas
# MONGO_URI = mongodb://localhost:27017
# Opcional: base distinta a Mongo_BD para LogiSmart
# LOGISMART_DB = logismart

# Opcional: modelo y servidor de Ollama
# OLLAMA_MODEL = llama3.2
# OLLAMA_HOST = http://localhost:11434
